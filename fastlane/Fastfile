# Mini Planète — iOS release lane, run on a GitHub macOS runner.
#   bundle exec fastlane ios beta
# Steps: API key → build number → signing → Godot export → Xcode build → TestFlight.

default_platform(:ios)

ROOT = File.expand_path("..", __dir__)
SIGNING_DIR = File.join(ROOT, "build", "signing")

def require_env(name)
  value = ENV[name].to_s.strip
  UI.user_error!("Missing secret #{name} (see BUILD.md)") if value.empty?
  value
end

platform :ios do
  desc "Export with Godot, build, sign and upload to TestFlight"
  lane :beta do
    team_id = require_env("APPLE_TEAM_ID")
    bundle_id = require_env("APP_BUNDLE_ID")

    # 1. App Store Connect API key (no Apple ID / 2FA needed).
    api_key = app_store_connect_api_key(
      key_id: require_env("ASC_KEY_ID"),
      issuer_id: require_env("ASC_ISSUER_ID"),
      key_content: require_env("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )

    # 2. Build number: always above the latest TestFlight build.
    latest = latest_testflight_build_number(
      api_key: api_key, app_identifier: bundle_id, initial_build_number: 0
    ).to_i
    build_number = [latest + 1, ENV["GITHUB_RUN_NUMBER"].to_i].max
    app_version = File.read(File.join(ROOT, "VERSION")).strip
    UI.message("Version #{app_version} (build #{build_number})")

    # 3. Signing: temporary keychain + distribution certificate + profile.
    setup_ci(force: true)
    FileUtils.mkdir_p(SIGNING_DIR)
    p12_path = File.join(SIGNING_DIR, "distribution.p12")
    File.binwrite(p12_path, Base64.decode64(require_env("IOS_DIST_CERT_P12_BASE64")))
    import_certificate(
      certificate_path: p12_path,
      certificate_password: ENV["IOS_DIST_CERT_PASSWORD"].to_s,
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )
    profile_path = File.join(SIGNING_DIR, "appstore.mobileprovision")
    File.binwrite(profile_path, Base64.decode64(require_env("IOS_PROVISIONING_PROFILE_BASE64")))
    install_provisioning_profile(path: profile_path)
    profile_uuid = FastlaneCore::ProvisioningProfile.uuid(profile_path)
    profile_name = FastlaneCore::ProvisioningProfile.name(profile_path)
    UI.message("Provisioning profile: #{profile_name} (#{profile_uuid})")

    # 4. Godot → Xcode project.
    sh(
      {
        "PROFILE_UUID" => profile_uuid,
        "PROFILE_NAME" => profile_name,
        "APP_VERSION" => app_version,
        "BUILD_NUMBER" => build_number.to_s
      },
      File.join(ROOT, "ci", "export_ios.sh")
    )
    xcodeproj = File.read(File.join(ROOT, "build", "ios", "xcodeproj_path.txt")).strip
    scheme = File.basename(xcodeproj, ".xcodeproj")

    # 5. Force manual signing with our certificate and profile.
    update_code_signing_settings(
      path: xcodeproj,
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      profile_uuid: profile_uuid,
      bundle_identifier: bundle_id,
      build_configurations: ["Release"]
    )

    # 6. Archive + IPA.
    ipa = build_app(
      project: xcodeproj,
      scheme: scheme,
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(ROOT, "build", "ipa"),
      output_name: "MiniPlanete.ipa",
      clean: true,
      export_options: {
        provisioningProfiles: { bundle_id => profile_name },
        signingStyle: "manual",
        teamID: team_id
      }
    )

    # 7. TestFlight (does not wait for Apple's processing: saves runner minutes).
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true
    )
  end
end
